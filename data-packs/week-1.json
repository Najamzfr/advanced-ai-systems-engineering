  "fixture": [
    [
      "text",
      "label"
    ],
    [
      "I am still waiting for my card",
      "card_arrival"
    ],
    [
      "How do I verify my identity",
      "verify_my_identity"
    ],
    [
      "The cash withdrawal shows twice",
      "cash_withdrawal_charge"
    ]
  ],
  "files": [
    "data/manifest.json",
    "scripts/fetch_banking77.py",
    "evals/providers.py",
    "evals/run.py",
    "reports/metrics.json",
    "reports/grade.json",
    "reports/model_selection.md",
